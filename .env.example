# --- Authority: paper or research; live execution is not supported ---
EXECUTION_MODE=paper
AUTO_TRADE_ENABLED=true
# --- Broker (Alpaca order transport is always paper, regardless of ALPACA_PAPER) ---
BROKER=alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex
ALPACA_MOVERS_TOP=25

# --- Finnhub (free tier: today's earnings calendar + news) ---
FINNHUB_API_KEY=

# --- Interactive Brokers (only if BROKER=ibkr; TWS or IB Gateway must be running) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497            # 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper, 4001 = Gateway live
IBKR_CLIENT_ID=17

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Supabase (optional; falls back to in-memory store if blank) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Paper trading rules (runtime toggle resets to the environment on restart) ---
AUTO_TRADE_THRESHOLD=90
MAX_TRADES_PER_DAY=2
MAX_DAILY_LOSS=100
RISK_PER_TRADE=25
MAX_POSITION_SIZE=1000

# --- Candidate filters ---
MIN_GAP_PCT=8
MIN_RELATIVE_VOLUME=3
# Liquidity limits are initial engineering defaults, not Kenny's published rules.
MIN_DOLLAR_VOLUME_5M=250000
MAX_SPREAD_PCT=1.0
MAX_SPREAD_RISK_PCT=20
MAX_VOLUME_PARTICIPATION_PCT=1.0
MAX_QUOTE_AGE_SECONDS=15
MIN_ACTIVE_MINUTES=4

# --- Detection timing (completed 1-minute candles) ---
SCAN_INTERVAL_SECONDS=60
BAR_POLL_INTERVAL_SECONDS=10
MAX_SIGNAL_BAR_AGE_SECONDS=90
MORNING_ONLY=true
SETUP_LOW_LOOKBACK_BARS=5
MAX_ACTIVE_SYMBOLS=100

# --- Dashboard ---
API_HOST=127.0.0.1
API_PORT=8000
